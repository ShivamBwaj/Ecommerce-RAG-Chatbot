OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4.1-mini
# GROQ_API_KEY2..7 are optional - the LLM client round-robins across
# whichever of these are set, to spread load across Groq's free-tier
# per-key rate limits (see api/core/llm.py)
GROQ_API_KEY=key
GROQ_API_KEY2=key2
GROQ_API_KEY3=key3
GROQ_API_KEY4=key4
GROQ_API_KEY5=key5
GROQ_API_KEY6=key6
GROQ_API_KEY7=key7
GOOGLE_API_KEY=keyy
GEMINI_API_KEY=keyy
HF_API_TOKEN=keyy
# EMBEDDING_PROVIDER: "openai" or "huggingface" - huggingface is the fully
# free path (used by the live deployment); openai needs OPENAI_API_KEY/
# OPENAI_EMBEDDING_MODEL/OPENAI_EMBEDDING_DIMENSIONS set instead.
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_DENSE_VECTOR_NAME=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=amazon-items-collection-01-hybrid-search
QDRANT_SPARSE_VECTOR_NAME=bm25
POSTGRES_DSN=postgresql://langgraph_user:langgraph_password@postgres:5432/langgraph_db
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=api
LANGSMITH_PROJECT="rag-tracing"
CO_API_KEY=keyy
